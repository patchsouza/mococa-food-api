NODE_ENV=development
PORT=3000
HOST=0.0.0.0
MONGO_URI=mongodb://localhost:27017/mococa_food
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=4h

# Keep Pix disabled until a platform-owned receiving key and signed provider webhook are configured.
PIX_ENABLED=false
PIX_EXPIRATION_MINUTES=30
PIX_WEBHOOK_SECRET=replace-with-a-shared-provider-secret
PIX_RECEIVER_KEY=
PIX_RECEIVER_KEY_TYPE=email
PIX_RECEIVER_NAME=
PIX_RECEIVER_CITY=MOCOCA# Servidor
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/mococa_food

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=7d

# Regras de negócio
DELIVERY_SEARCH_RADIUS_KM=6
COURIER_OFFER_TTL_SECONDS=25
DELIVERY_OFFER_RETRY_INTERVAL_MS=120000

# Pix
PIX_ENABLED=true
PIX_EXPIRATION_MINUTES=30
PIX_WEBHOOK_SECRET=troque-este-segredo-do-webhook-pix

# Validação de assinatura do webhook Pix ("false" apenas para testes em dev)
PIX_WEBHOOK_REQUIRE_SIGNATURE=true
