# Servidor
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/mococa_food

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=7d

# Regras de negócio
DELIVERY_SEARCH_RADIUS_KM=6
COURIER_OFFER_TTL_SECONDS=25

# Pix
PIX_ENABLED=true
PIX_EXPIRATION_MINUTES=30
PIX_WEBHOOK_SECRET=troque-este-segredo-do-webhook-pix

# Validação de assinatura do webhook Pix ("false" apenas para testes em dev)
PIX_WEBHOOK_REQUIRE_SIGNATURE=true
